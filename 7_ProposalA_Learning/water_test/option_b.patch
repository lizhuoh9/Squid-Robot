 #include <Calibration.h>
 #include <Sys.h>
+
+namespace {
+// Candidate delay compensation (one controller instance): the pump acceleration commanded on each
+// motion tick (5 ms), as the Minima delivers it (zero during the pump lock that follows a valve
+// change), with the tick's length so jitter in the motion task does not bias the prediction.
+constexpr int kPredTicks = 512;
+constexpr uint32_t kTickMs = 5;
+constexpr uint32_t kMaxTickMs = 20;
+float g_predAccel[kPredTicks] = {};
+float g_predDt[kPredTicks] = {};
+uint32_t g_predStamp[kPredTicks] = {};
+int g_predHead = 0;
+int g_predCount = 0;
+bool g_predValvesOpen = false;
+uint32_t g_predLockUntil = 0;
+
+void recordPumpAcceleration(uint32_t nowMs, uint8_t direction, float applied) {
+    const bool open = direction == cal::BUOY_RISE;
+    if (open != g_predValvesOpen) {
+        g_predValvesOpen = open;
+        g_predLockUntil = nowMs + depth_cfg::PRED_LOCK_MS;
+    }
+    float a = 0.0f;
+    if (applied > 0.0f && static_cast<int32_t>(g_predLockUntil - nowMs) <= 0) {
+        a = (direction == cal::BUOY_SINK) ? applied * depth_cfg::G_SINK : -applied * depth_cfg::G_RISE;
+    }
+    uint32_t tick = g_predCount > 0 ? nowMs - g_predStamp[g_predHead] : kTickMs;
+    if (tick == 0 || tick > kMaxTickMs) tick = kTickMs;
+    g_predHead = (g_predHead + 1) % kPredTicks;
+    g_predAccel[g_predHead] = a;
+    g_predDt[g_predHead] = static_cast<float>(tick) * 0.001f;
+    g_predStamp[g_predHead] = nowMs;
+    if (g_predCount < kPredTicks) ++g_predCount;
+}
+
+// Called from resetAfterCalibration(), i.e. from begin(): no history survives into a new run.
+void resetPrediction() {
+    for (int i = 0; i < kPredTicks; ++i) {
+        g_predAccel[i] = 0.0f;
+        g_predDt[i] = 0.0f;
+        g_predStamp[i] = 0;
+    }
+    g_predHead = 0;
+    g_predCount = 0;
+    g_predValvesOpen = false;
+    g_predLockUntil = 0;
+}
+
+// Error and speed expected PRED_HORIZON_S ahead: pump commands of the last horizon have not acted
+// yet; the heaviness acts throughout.
+void predictState(uint32_t nowMs, float heaviness, float& e, float& v) {
+    const float H = depth_cfg::PRED_HORIZON_S;
+    float dv = heaviness * H;
+    float de = v * H + 0.5f * heaviness * H * H;
+    const uint32_t horizonMs = static_cast<uint32_t>(H * 1000.0f + 0.5f);
+    for (int k = 0, i = g_predHead; k < g_predCount; ++k, i = (i + kPredTicks - 1) % kPredTicks) {
+        const uint32_t age = nowMs - g_predStamp[i];
+        if (age > horizonMs) break;
+        const float step = g_predDt[i] * g_predAccel[i];
+        dv += step;
+        de += step * (static_cast<float>(age) * 0.001f);
+    }
+    e += de;
+    v += dv;
+}
+}  // namespace
 
